  createTicket(){
    this.openModal("New Ticket", '<div class="field"><label class="field-label">Subject</label><div class="input-wrap"><input id="ticketSubj" placeholder="Brief description" /></div></div>'+
      '<div class="field"><label class="field-label">Message</label><div class="input-wrap"><textarea id="ticketMsg" rows="4" style="resize:vertical" placeholder="Describe your issue..."></textarea></div></div>', ()=>{
      const subj = ($("#ticketSubj")?.value||"").trim();
      const msg = ($("#ticketMsg")?.value||"").trim();
      if(!subj||!msg) return Toast.show("Fill all fields","error");
      const ticket = { id:"t"+Date.now(), userId:Session.user.id, subject:subj, messages:[{from:"user",text:msg,at:Date.now()}], status:"open", at:Date.now() };
      DB.data.tickets.push(ticket);
      DB.save();
      Toast.show("Ticket created","success");
      this.closeModal(); this.render();
    });
  },
  viewTicket(id){
    const t = DB.data.tickets.find(x=>x.id===id);
    if(!t) return;
    this.openModal("Ticket: "+t.subject,
      t.messages.map(m=>'<div class="chat-msg '+(m.from==="user"?"me":"bot")+'">'+esc(m.text)+'<div class="fz12 muted" style="margin-top:4px">'+fmtTime(m.at)+'</div></div>').join("")+
      '<div class="mt-12"><div class="input-wrap"><input id="ticketReply" placeholder="Add a reply..." /></div></div>', ()=>{
      const reply = ($("#ticketReply")?.value||"").trim();
      if(!reply) return Toast.show("Type a reply","error");
      t.messages.push({from:"user",text:reply,at:Date.now()});
      DB.save(); Toast.show("Reply sent","success"); this.closeModal(); this.render();
    });
  },

  /* ---------- NOTIFICATIONS ---------- */
