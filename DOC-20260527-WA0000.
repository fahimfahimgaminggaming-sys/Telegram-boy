    const u = DB.data.users.find(x=>x.email.toLowerCase()===email.toLowerCase() && x.pass===pass);
    if(!u) return { ok:false, msg:"Invalid email or password" };
    if(u.banned) return { ok:false, msg:"This account is banned" };
    this.user = u;
    localStorage.setItem(SESSION_KEY, u.id);
    return { ok:true };
  },
  register(name, email, pass){
    if(!name||!email||!pass) return { ok:false, msg:"All fields required" };
    if(pass.length<6) return { ok:false, msg:"Password must be 6+ chars" };
    if(!/^\S+@\S+\.\S+$/.test(email)) return { ok:false, msg:"Invalid email" };
    if(DB.data.users.find(x=>x.email.toLowerCase()===email.toLowerCase())) return { ok:false, msg:"Email already registered" };
    const u = { id:"u"+Date.now(), name, email, pass, balance:0, role:"user", banned:false, createdAt:Date.now(), totalSpent:0 };
