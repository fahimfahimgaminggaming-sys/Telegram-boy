  /* ---------- TX HISTORY ---------- */
  pageTxHistory(){
    const u = Session.user;
    const txs = [];
    DB.data.orders.filter(o=>o.userId===u.id).forEach(o=>{ txs.push({type:"purchase",amount:-o.total,at:o.at,desc:"Purchase order #"+o.id.slice(-6)}); });
    DB.data.deposits.filter(d=>d.userId===u.id && d.status==="approved").forEach(d=>{ txs.push({type:"deposit",amount:d.amount,at:d.at,desc:"Deposit via "+d.method}); });
