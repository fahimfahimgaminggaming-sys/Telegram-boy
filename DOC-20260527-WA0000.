              <strong style="color:var(--gold)">App.GOOGLE_CLIENT_ID</strong>
            </p>
          </div>
          <div style="background:rgba(212,175,55,.08);border:1px solid var(--border-2);border-radius:12px;padding:14px;font-size:12px;color:var(--text-2);line-height:1.8">
            1. Visit <span style="color:var(--gold)">console.cloud.google.com</span><br>
            2. APIs &amp; Services → Credentials<br>
            3. Create OAuth 2.0 Client ID (Web application)<br>
            4. Add your domain to Authorized Origins<br>
            5. Replace <code style="color:var(--gold)">YOUR_GOOGLE_CLIENT_ID</code> in the source
          </div>
        `, null, "Got it");
        return;
      }

      google.accounts.id.initialize({
        client_id: this.GOOGLE_CLIENT_ID,
        callback: (resp) => this.handleGoogleCredential(resp),
        auto_select: false,
        cancel_on_tap_outside: true
      });
      google.accounts.id.prompt((notification) => {
        if(notification.isSkippedMoment() || notification.isDismissedMoment()){
          /* Fallback to popup OAuth if one-tap dismissed */
          google.accounts.id.renderButton(
            document.createElement("div"),
            { theme:"filled_black", size:"large" }
          );
          btn.classList.remove("loading");
          Toast.show("Please try again or use email login","info");
        }
      });
    } else {
      /* GSI library not loaded yet (e.g. offline / blocked) */
      btn.classList.remove("loading");
      Toast.show("Google services unavailable. Use email login.","error");
    }
  },

