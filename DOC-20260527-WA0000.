  removeFromCart(pid){
    const u = Session.user;
    const c = DB.data.cart[u.id]||[];
    DB.data.cart[u.id] = c.filter(x=>x.pid!==pid);
    DB.save();
    Toast.show("Removed from cart");
    this.render();
  },
  checkout(){
    const u = Session.user;
    const items = DB.data.cart[u.id]||[];
    if(!items.length) return Toast.show("Cart is empty","error");
    const cartItems = items.map(ci=>{
      const p = DB.data.products.find(x=>x.id===ci.pid);
      return { ...ci, p };
    }).filter(x=>x.p);
    const total = cartItems.reduce((a,b)=>a+b.p.price*b.qty,0);
    if(u.balance<total) return Toast.show("Insufficient balance. Deposit funds first.","error");
    u.balance -= total;
    const order = { id:"o"+Date.now(), userId:u.id, items:cartItems.map(ci=>({pid:ci.pid,qty:ci.qty,price:ci.p.price})), total, status:"completed", at:Date.now() };
    DB.data.orders.unshift(order);
    DB.data.cart[u.id] = [];
    cartItems.forEach(ci=>{ ci.p.sold = (ci.p.sold||0)+ci.qty; });
    DB.save();
    showConfetti();
    Toast.show("Order placed successfully!","success");
    Notify.push(u.id,"Order confirmed","Order #"+order.id.slice(-6)+" placed for "+fmt(total),"✓");
    this.go("orders");
  },
  buyNow(pid){
    const u = Session.user;
    const p = DB.data.products.find(x=>x.id===pid);
    if(!p) return;
    if(!(p.stock||[]).length) return Toast.show("Out of stock","error");
    if(u.balance<p.price) return Toast.show("Insufficient balance. Deposit funds first.","error");
    u.balance -= p.price;
    const order = { id:"o"+Date.now(), userId:u.id, items:[{pid,qty:1,price:p.price}], total:p.price, status:"completed", at:Date.now() };
    DB.data.orders.unshift(order);
    p.sold = (p.sold||0)+1;
    DB.save();
    showConfetti();
    Toast.show("Order placed successfully!","success");
    Notify.push(u.id,"Order confirmed","Order #"+order.id.slice(-6)+" placed for "+fmt(p.price),"✓");
    this.openModal("Order Complete","<div style='text-align:center'><div style='font-size:48px;margin-bottom:12px'>✓</div><h3>Order #"+order.id.slice(-6)+"</h3><p class='muted'>Your credentials will be delivered shortly.</p></div>",null,true);
    setTimeout(()=>this.go("orders"),2000);
  },

