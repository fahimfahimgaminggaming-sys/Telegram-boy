  /* ---------- CART ---------- */
  addToCart(pid){
    const u = Session.user;
    const p = DB.data.products.find(x=>x.id===pid);
    if(!p) return;
    if(!(p.stock||[]).length) return Toast.show("Out of stock","error");
    DB.data.cart[u.id] ||= [];
    const c = DB.data.cart[u.id];
    const ex = c.find(x=>x.pid===pid);
    if(ex){
      if(ex.qty >= (p.stock||[]).length) return Toast.show("Max stock reached","error");
      ex.qty++;
    } else c.push({ pid, qty:1 });
    DB.save();
    Toast.show("Added to cart","success");
    this.render();
