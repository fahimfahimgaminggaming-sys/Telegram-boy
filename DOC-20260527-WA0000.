  /* ---------- GOOGLE OAUTH 2.0 — Social Auth ----------
   *
   * ┌─────────────────────────────────────────────────────┐
   * │  SETUP (3 steps):                                   │
   * │  1. Go to https://console.cloud.google.com          │
   * │  2. APIs & Services → Credentials → Create OAuth    │
   * │     Client ID (Web application)                     │
   * │  3. Replace GOOGLE_CLIENT_ID below with your ID     │
   * └─────────────────────────────────────────────────────┘
   */
  GOOGLE_CLIENT_ID: "620492064107-ivvrviu2e50ri7v558gnv9c5umi2q7rn.apps.googleusercontent.com",

  /* Called by the Google GSI library after user picks account */
  handleGoogleCredential(response){
    try{
      /* Decode JWT payload (no signature verify needed client-side) */
      const base64Url = response.credential.split('.')[1];
      const base64 = base64Url.replace(/-/g,'+').replace(/_/g,'/');
      const payload = JSON.parse(atob(base64));
      const { sub, email, name, picture } = payload;

      if(!email) return Toast.show("Google auth failed — no email returned","error");

      /* Check if user already exists by email */
      let user = DB.data.users.find(u=>u.email.toLowerCase()===email.toLowerCase());

      if(user){
        /* Existing user — log in */
        if(user.banned) return Toast.show("This account is banned","error");
        /* Attach Google sub if not already linked */
        if(!user.googleSub){ user.googleSub = sub; DB.save(); }
        Session.user = user;
        localStorage.setItem(SESSION_KEY, user.id);
        showConfetti();
        Toast.show("Welcome back, "+user.name+"! 👋","success");
        App.go("home");
      } else {
        /* New user — auto-register via Google */
        const newUser = {
          id: "u"+Date.now(),
          name: name || email.split("@")[0],
          email,
          pass: null,         /* no password for social accounts */
          googleSub: sub,
          avatar: picture || null,
          balance: 0,
          role: "user",
          banned: false,
          createdAt: Date.now(),
          totalSpent: 0,
          authProvider: "google"
        };
        DB.data.users.push(newUser);
        DB.save();
        Session.user = newUser;
        localStorage.setItem(SESSION_KEY, newUser.id);
        showConfetti();
        Notify.push(newUser.id, "Welcome to TrustBuy! 🎉", "Your Google account is now linked. Start shopping.");
        Toast.show("Account created via Google! Welcome, "+newUser.name,"success");
        App.go("home");
      }
    }catch(err){
      console.error("[Google Auth]", err);
      Toast.show("Google sign-in failed. Try again.","error");
    }
    /* Remove loading state from button */
    document.querySelectorAll(".social-btn").forEach(b=>b.classList.remove("loading"));
  },

  /* Triggered when user clicks "Continue with Google" */
  doGoogleSignIn(btn){
    btn.classList.add("loading");

    /* ── If GSI library loaded → use One Tap / popup flow ── */
    if(window.google && google.accounts && google.accounts.id){
      if(this.GOOGLE_CLIENT_ID === "YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"){
        btn.classList.remove("loading");
        this.openModal("Google OAuth Setup", `
          <div style="text-align:center;padding:8px 0 16px">
            <div style="font-size:40px;margin-bottom:12px">🔑</div>
            <h3 style="margin:0 0 8px;font-size:17px">Configure Google OAuth</h3>
