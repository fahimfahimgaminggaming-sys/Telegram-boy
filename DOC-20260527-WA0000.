  /* ---------- CHAT ---------- */
  toggleChat(force){
    const p = document.getElementById("chatPanel");
    const show = force===undefined ? !p.classList.contains("show") : force;
    p.classList.toggle("show", show);
    if(show && !p.dataset.init){
      p.dataset.init = "1";
      const msgs = document.getElementById("chatMsgs");
      msgs.innerHTML = '<div class="chat-msg bot">Hi '+esc(Session.user.name)+'! 👋 I\'m here to help. For instant support tap below.</div><div class="chat-msg bot">📧 <a href="'+SUPPORT_TG+'" target="_blank" style="color:var(--gold)">Open Telegram support</a></div>';
    }
  },
  sendChat(){
    const i = document.getElementById("chatInput");
    const v = i.value.trim(); if(!v) return;
    const msgs = document.getElementById("chatMsgs");
    msgs.insertAdjacentHTML("beforeend",'<div class="chat-msg me">'+esc(v)+'</div>');
    i.value="";
    msgs.scrollTop = msgs.scrollHeight;
    setTimeout(()=>{
      msgs.insertAdjacentHTML("beforeend",'<div class="chat-msg bot">Thanks! Our team will reply on <a href="'+SUPPORT_TG+'" target="_blank" style="color:var(--gold)">Telegram</a> shortly.</div>');
      msgs.scrollTop = msgs.scrollHeight;
    }, 800);
  },

  /* ---------- ADMIN ---------- */
  pageAdmin(){
    if(Session.user.role!=="admin") return '<div class="empty">Access denied</div>';
    const tabs = [["dash","Dashboard"],["prods","Products"],["orders","Orders"],["deps","Deposits"],["users","Users"],["coupons","Coupons"],["banners","Banners"],["cats","Categories"],["tickets","Tickets"],["broadcast","Broadcast"],["settings","Settings"]];
    return '<div class="page"><h2 class="section-title mb-12">Admin Panel</h2>'+
      '<div class="tabs">'+tabs.map(([k,l])=>'<button class="tab '+(this._adminTab===k?"active":"")+'" onclick="App._adminTab=\''+k+'\';App.render()">'+l+'</button>').join("")+'</div>'+
      this.renderAdminTab()+'</div>';
  },
  renderAdminTab(){
    switch(this._adminTab){
      case "dash": return this.adminDash();
      case "prods": return this.adminProds();
      case "orders": return this.adminOrders();
      case "deps": return this.adminDeps();
      case "users": return this.adminUsers();
      case "coupons": return this.adminCoupons();
      case "banners": return this.adminBanners();
      case "cats": return this.adminCats();
      case "tickets": return this.adminTickets();
      case "broadcast": return this.adminBroadcast();
      case "settings": return this.adminSettings();
    }
  },
  adminDash(){
    const d = DB.data;
    const rev = d.orders.reduce((a,o)=>a+o.total,0);
    return '<div class="stat-grid">'+
      '<div class="stat"><div class="stat-label">Users</div><div class="stat-val">'+d.users.length+'</div></div>'+
      '<div class="stat"><div class="stat-label">Orders</div><div class="stat-val">'+d.orders.length+'</div></div>'+
      '<div class="stat"><div class="stat-label">Revenue</div><div class="stat-val gold">'+fmt(rev)+'</div></div>'+
      '<div class="stat"><div class="stat-label">Pending Deposits</div><div class="stat-val">'+d.deposits.filter(x=>x.status==="pending").length+'</div></div></div>'+
      '<div class="chart-wrap"><div style="display:flex;justify-content:space-between;margin-bottom:8px"><div style="font-weight:700">Revenue (7d)</div></div>'+
      '<canvas id="revenueChart" height="200"></canvas></div>'+
      '<div class="chart-wrap"><div style="font-weight:700;margin-bottom:8px">Product Performance</div>'+
      '<canvas id="productChart" height="200"></canvas></div>';
  },
  renderAdminCharts(){
    const d = DB.data;
    const last7 = Array.from({length:7},(_,i)=>{
      const day = new Date(); day.setHours(0,0,0,0); day.setDate(day.getDate()-(6-i));
      const next = day.getTime()+86400000;
      const v = d.orders.filter(o=>o.at>=day.getTime() && o.at<next).reduce((a,o)=>a+o.total,0);
      return { label: day.toLocaleDateString(undefined,{weekday:"short"}), v };
    });
    const revCtx = document.getElementById("revenueChart");
    if(revCtx && typeof Chart!=="undefined"){
      new Chart(revCtx, {
        type:"line",
        data:{ labels:last7.map(x=>x.label), datasets:[{label:"Revenue",data:last7.map(x=>x.v),borderColor:"#d4af37",backgroundColor:"rgba(212,175,55,.15)",fill:true,tension:.4,pointBackgroundColor:"#d4af37"}]},
        options:{ responsive:true, plugins:{legend:{display:false}}, scales:{ y:{beginAtZero:true,ticks:{color:"#888"},grid:{color:"rgba(255,255,255,.05)"}}, x:{ticks:{color:"#888"},grid:{display:false}} } }
      });
    }
    const prodCtx = document.getElementById("productChart");
    if(prodCtx && typeof Chart!=="undefined"){
      new Chart(prodCtx, {
        type:"bar",
        data:{ labels:d.products.map(p=>p.title.split(" ").slice(0,2).join(" ")),
          datasets:[{label:"Sold",data:d.products.map(p=>p.sold||0),backgroundColor:"rgba(212,175,55,.6)",borderRadius:8}]},
        options:{ responsive:true, plugins:{legend:{display:false}}, scales:{ y:{beginAtZero:true,ticks:{color:"#888"},grid:{color:"rgba(255,255,255,.05)"}}, x:{ticks:{color:"#888",font:{size:10}},grid:{display:false}} } }
      });
    }
  },
  adminProds(){
    const q = this._adminSearch.toLowerCase();
    let prods = DB.data.products;
    if(q) prods = prods.filter(p=>p.title.toLowerCase().includes(q)||p.category.toLowerCase().includes(q));
    return '<div class="search-bar mb-12"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>'+
      '<input placeholder="Search products..." value="'+esc(this._adminSearch)+'" oninput="App._adminSearch=this.value;App.render()" /></div>'+
      '<button class="btn btn-primary mb-12" onclick="App.editProduct()">+ New product</button>'+
      prods.map(p=>
        '<div class="list-item"><div class="list-img" style="background-image:url(\''+esc(p.image)+'\')"></div>'+
        '<div class="list-body"><p class="list-title">'+esc(p.title)+'</p>'+
        '<p class="list-sub">'+fmt(p.price)+' · '+(p.stock||[]).length+' stock · '+(p.sold||0)+' sold</p></div>'+
        '<div class="row" style="flex:0 0 auto;gap:6px">'+
        '<button class="add-btn" style="background:var(--surface-2);color:var(--text);font-size:14px" onclick="App.editProduct(\''+p.id+'\')">\u270e</button>'+
        '<button class="add-btn" style="background:rgba(255,69,58,.2);color:var(--danger);font-size:14px" onclick="App.delProduct(\''+p.id+'\')">\ud83d\uddd1</button></div></div>').join("");
  },
  editProduct(id){
    const p = id ? DB.data.products.find(x=>x.id===id) : { id:"p"+Date.now(), title:"", category:"Streaming", price:0, oldPrice:0, image:"", stock:[], desc:"", featured:false, sold:0 };
    this.openModal("Product", `
      <div class="field"><label class="field-label">Title</label><div class="input-wrap"><input id="pf_title" value="${esc(p.title)}" /></div></div>
      <div class="field"><label class="field-label">Category</label><div class="input-wrap"><input id="pf_cat" value="${esc(p.category)}" /></div></div>
      <div class="row">
        <div class="field"><label class="field-label">Price</label><div class="input-wrap"><input id="pf_price" type="number" step="0.01" value="${p.price}" /></div></div>
        <div class="field"><label class="field-label">Old price</label><div class="input-wrap"><input id="pf_old" type="number" step="0.01" value="${p.oldPrice||0}" /></div></div>
      </div>
      <div class="field"><label class="field-label">Image URL or upload</label>
        <div class="input-wrap"><input id="pf_img" value="${esc(p.image)}" placeholder="https://..." /></div>
        <input type="file" id="pf_imgfile" accept="image/*" style="margin-top:8px;font-size:12px" onchange="App._readImg(event,'pf_img')" /></div>
      <div class="field"><label class="field-label">Description</label><div class="input-wrap"><textarea id="pf_desc" rows="3" style="resize:vertical">${esc(p.desc||"")}</textarea></div></div>
      <div class="field"><label class="field-label">Stock (one account per line, format email:pass)</label><div class="input-wrap"><textarea id="pf_stock" rows="4" style="resize:vertical;font-family:monospace;font-size:13px">${esc((p.stock||[]).join("\n"))}</textarea></div></div>
      <label style="display:flex;gap:8px;align-items:center;margin-top:8px"><input type="checkbox" id="pf_feat" ${p.featured?"checked":""} style="width:auto" /> Featured</label>
    `, ()=>{
      p.title = ($("#pf_title")?.value||"").trim();
      p.category = ($("#pf_cat")?.value||"").trim()||"General";
      p.price = parseFloat($("#pf_price")?.value)||0;
      p.oldPrice = parseFloat($("#pf_old")?.value)||0;
      p.image = ($("#pf_img")?.value||"").trim();
      p.desc = ($("#pf_desc")?.value||"").trim();
      p.stock = ($("#pf_stock")?.value||"").split("\n").map(s=>s.trim()).filter(Boolean);
      p.featured = $("#pf_feat")?.checked||false;
      if(!p.title) return Toast.show("Title required","error");
      if(!id) DB.data.products.push(p);
      DB.save(); Toast.show("Saved","success"); this.closeModal(); this.render();
    });
  },
  _readImg(e, targetId){
    const f = e.target.files?.[0]; if(!f) return;
    if(f.size>2*1024*1024) return Toast.show("Image too large (2MB max)","error");
    const r = new FileReader();
    r.onload = ev=>{ document.getElementById(targetId).value = ev.target.result; Toast.show("Image loaded","success"); };
    r.readAsDataURL(f);
  },
  delProduct(id){
    if(!confirm("Delete this product?")) return;
    DB.data.products = DB.data.products.filter(x=>x.id!==id);
    DB.save(); this.render();
  },
  adminOrders(){
    const q = this._adminSearch.toLowerCase();
    let orders = DB.data.orders;
    if(q) orders = orders.filter(o=>{
      const u = DB.data.users.find(x=>x.id===o.userId);
      return o.id.includes(q) || u?.email.toLowerCase().includes(q);
    });
    return '<div class="search-bar mb-12"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>'+
      '<input placeholder="Search orders..." value="'+esc(this._adminSearch)+'" oninput="App._adminSearch=this.value;App.render()" /></div>'+
      (orders.length?orders.map(or=>{
        const u = DB.data.users.find(x=>x.id===or.userId);
        return '<div class="glass mb-8" style="padding:12px">'+
          '<div style="display:flex;justify-content:space-between"><div><b>#'+or.id.slice(-6)+'</b><div class="muted fz12">'+esc(u?.email||"?")+' · '+fmtTime(or.at)+'</div></div><div class="gold" style="font-weight:700">'+fmt(or.total)+'</div></div>'+
          '<div class="fz12 muted mt-8">'+or.items.length+' item(s)</div></div>';
      }).join(""):'<p class="muted">No orders</p>');
  },
  adminDeps(){
    const q = this._adminSearch.toLowerCase();
    let deps = DB.data.deposits;
    if(q) deps = deps.filter(d=>{
      const u = DB.data.users.find(x=>x.id===d.userId);
      return d.id.includes(q) || u?.email.toLowerCase().includes(q);
    });
    return '<div class="search-bar mb-12"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>'+
      '<input placeholder="Search deposits..." value="'+esc(this._adminSearch)+'" oninput="App._adminSearch=this.value;App.render()" /></div>'+
      (deps.length?deps.map(d=>{
        const u = DB.data.users.find(x=>x.id===d.userId);
        return '<div class="glass mb-8" style="padding:12px">'+
          '<div style="display:flex;justify-content:space-between;align-items:center">'+
          '<div><b>'+fmt(d.amount)+'</b> via '+esc(d.method)+'<div class="muted fz12">'+esc(u?.email||"?")+' · '+fmtTime(d.at)+'</div></div>'+
          '<span class="status-pill status-'+d.status+'">'+d.status+'</span></div>'+
          (d.txid?'<div class="fz12 muted mt-8">TXID: '+esc(d.txid)+'</div>':'')+
          (d.proof?'<img src="'+d.proof+'" style="max-width:100px;border-radius:6px;margin-top:8px;cursor:pointer" onclick="window.open(\''+d.proof+'\',\'_blank\')" />':'')+
          (d.status==="pending"?'<div class="row mt-8"><button class="btn btn-success" onclick="App.approveDep(\''+d.id+'\')">Approve</button><button class="btn btn-danger" onclick="App.rejectDep(\''+d.id+'\')">Reject</button></div>':'')+'</div>';
      }).join(""):'<p class="muted">No deposits</p>');
  },
  approveDep(id){
    const d = DB.data.deposits.find(x=>x.id===id); if(!d||d.status!=="pending") return;
    const u = DB.data.users.find(x=>x.id===d.userId);
    if(u){ u.balance += d.amount; Notify.push(u.id,"Deposit approved","+"+fmt(d.amount)+" added to wallet.","✅"); }
    d.status="approved"; DB.save(); Toast.show("Approved","success"); this.render();
  },
  rejectDep(id){
    const d = DB.data.deposits.find(x=>x.id===id); if(!d) return;
    d.status="rejected"; Notify.push(d.userId,"Deposit rejected","Contact support if needed.","❌");
    DB.save(); Toast.show("Rejected"); this.render();
  },
  adminUsers(){
    const q = this._adminSearch.toLowerCase();
    let users = DB.data.users;
    if(q) users = users.filter(u=>u.name.toLowerCase().includes(q)||u.email.toLowerCase().includes(q));
    return '<div class="search-bar mb-12"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>'+
      '<input placeholder="Search users..." value="'+esc(this._adminSearch)+'" oninput="App._adminSearch=this.value;App.render()" /></div>'+
      '<button class="btn btn-secondary mb-12" onclick="App.exportUsers()">📥 Export users (CSV)</button>'+
      users.map(u=>
        '<div class="list-item"><div class="avatar" style="width:44px;height:44px;font-size:16px;flex:0 0 44px">'+esc((u.name||"U")[0].toUpperCase())+'</div>'+
        '<div class="list-body"><p class="list-title">'+esc(u.name)+(u.role==="admin"?' <span class="gold">★</span>':'')+'</p><p class="list-sub">'+esc(u.email)+' · '+fmt(u.balance)+'</p></div>'+
        '<div class="row" style="flex:0 0 auto;gap:6px">'+
          (u.role!=="admin"?
            '<button class="add-btn" style="background:rgba(212,175,55,.2);color:var(--gold);font-size:10px;width:auto;padding:0 8px" onclick="App.adjustBalance(\''+u.id+'\')">$</button>'+
            '<button class="add-btn" style="background:'+(u.banned?"rgba(48,209,88,.2);color:var(--success)":"rgba(255,69,58,.2);color:var(--danger)")+';font-size:12px;width:auto;padding:0 10px" onclick="App.toggleBan(\''+u.id+'\')">'+(u.banned?"Unban":"Ban")+'</button>'
          :'')+
        '</div></div>').join("");
  },
  exportUsers(){
    const users = DB.data.users;
    let csv = "ID,Name,Email,Balance,Role,Created\n";
    users.forEach(u=>{
      csv += `"${u.id}","${u.name}","${u.email}",${u.balance},"${u.role}","${fmtTime(u.createdAt)}"\n`;
    });
    const blob = new Blob([csv],{type:"text/csv"});
    const a = document.createElement("a");
    a.href = URL.createObjectURL(blob);
    a.download = "users-"+Date.now()+".csv";
    a.click();
    Toast.show("Exported","success");
  },
  toggleBan(id){
    const u = DB.data.users.find(x=>x.id===id); if(!u) return;
    u.banned = !u.banned; DB.save(); Toast.show(u.banned?"Banned":"Unbanned","success"); this.render();
