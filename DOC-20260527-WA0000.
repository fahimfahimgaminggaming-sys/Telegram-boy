    this.openModal("Edit Profile", '<div class="field"><label class="field-label">Display name</label><div class="input-wrap"><input id="editName" value="'+esc(u.name)+'" /></div></div>', ()=>{
      const n = ($("#editName")?.value||"").trim();
      if(n){ u.name = n; DB.save(); Toast.show("Profile updated","success"); this.closeModal(); this.render(); }
    });
  },
  changePass(){
    this.openModal("Change Password", `
      <div class="field"><label class="field-label">Current password</label><div class="input-wrap"><input id="curPass" type="password" /></div></div>
      <div class="field"><label class="field-label">New password (min 6)</label><div class="input-wrap"><input id="newPass" type="password" /></div></div>
    `, ()=>{
      const cur = ($("#curPass")?.value||"");
      const np = ($("#newPass")?.value||"");
      if(cur !== Session.user.pass) return Toast.show("Wrong current password","error");
      if(!np||np.length<6) return Toast.show("Too short","error");
      Session.user.pass = np; DB.save(); Toast.show("Password updated","success"); this.closeModal();
    });
  },
  exportData(){
    const blob = new Blob([JSON.stringify(DB.data,null,2)],{type:"application/json"});
    const a = document.createElement("a");
    a.href = URL.createObjectURL(blob);
    a.download = "trustbuy-backup-"+Date.now()+".json";
    a.click();
    Toast.show("Backup downloaded","success");
  },
  importData(e){
    const f = e.target.files?.[0]; if(!f) return;
    const r = new FileReader();
    r.onload = ev=>{
      try{
        const d = JSON.parse(ev.target.result);
        if(!d.users) throw new Error("Invalid backup");
        if(confirm("Replace all data with backup?")){
          DB.data = d; DB.save(); Toast.show("Restored","success"); this.render();
        }
      }catch(err){ Toast.show("Invalid backup file","error"); }
    };
    r.readAsText(f);
  },

