    return '<div class="page"><h2 class="section-title mb-16">Transaction History</h2>'+
      (txs.length?txs.map(tx=>
        '<div class="glass mb-8" style="padding:12px;display:flex;justify-content:space-between">'+
          '<div><div style="font-weight:600;font-size:13px">'+esc(tx.desc)+'</div><div class="muted fz12">'+fmtTime(tx.at)+'</div></div>'+
          '<div style="text-align:right;font-weight:700;color:'+(tx.type==="deposit"?"var(--success)":"var(--danger)")+'">'+fmt(tx.amount)+'</div>'+
        '</div>'
      ).join(""):'<div class="empty"><div class="empty-icon">📊</div><p>No transactions</p></div>')+
