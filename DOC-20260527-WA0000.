<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,viewport-fit=cover" />
<meta name="theme-color" content="#000000" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="description" content="TrustBuy - Premium digital marketplace with instant delivery" />
<title>TrustBuy.com — Premium Digital Marketplace</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%23000'/%3E%3Ctext x='32' y='42' font-family='Inter,sans-serif' font-size='32' font-weight='800' fill='%23d4af37' text-anchor='middle'%3ET%3C/text%3E%3C/svg%3E" />
<script src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
<style>
:root{
  --bg:#000;
  --bg-2:#0a0a0a;
  --surface:rgba(20,20,22,.72);
  --surface-2:rgba(28,28,32,.78);
  --border:rgba(255,255,255,.08);
  --border-2:rgba(212,175,55,.22);
  --text:#f5f5f7;
  --text-2:#a1a1a6;
  --muted:#6e6e73;
  --gold:#d4af37;
  --gold-2:#f0d78c;
  --gold-soft:rgba(212,175,55,.12);
  --danger:#ff453a;
  --success:#30d158;
  --info:#0a84ff;
  --radius:18px;
  --radius-sm:12px;
  --shadow:0 10px 40px rgba(0,0,0,.5);
  --ease:cubic-bezier(.22,.61,.36,1);
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;padding:0;background:var(--bg);color:var(--text);font-family:'Inter',-apple-system,BlinkMacSystemFont,sans-serif;-webkit-font-smoothing:antialiased;overflow-x:hidden;min-height:100vh}
body{background:radial-gradient(1200px 800px at 80% -10%,rgba(212,175,55,.08),transparent 60%),radial-gradient(900px 600px at -10% 100%,rgba(212,175,55,.05),transparent 60%),#000;padding-bottom:env(safe-area-inset-bottom)}
img{max-width:100%;display:block}
button{font-family:inherit;cursor:pointer;border:none;background:none;color:inherit}
input,textarea,select{font-family:inherit;font-size:16px;color:var(--text);background:transparent;border:none;outline:none;width:100%}
a{color:inherit;text-decoration:none}
::-webkit-scrollbar{width:6px;height:6px}
::-webkit-scrollbar-thumb{background:rgba(255,255,255,.1);border-radius:3px}

/* Loading */
#loader{position:fixed;inset:0;background:#000;display:flex;flex-direction:column;align-items:center;justify-content:center;z-index:9999;transition:opacity .5s var(--ease)}
#loader.hide{opacity:0;pointer-events:none}
.loader-logo{font-size:56px;font-weight:800;letter-spacing:-1px;background:linear-gradient(135deg,var(--gold),var(--gold-2));-webkit-background-clip:text;background-clip:text;color:transparent;margin-bottom:24px;animation:pulse 1.6s ease-in-out infinite}
.loader-ring{width:56px;height:56px;border:3px solid rgba(212,175,55,.18);border-top-color:var(--gold);border-radius:50%;animation:spin .8s linear infinite;box-shadow:0 0 40px rgba(212,175,55,.2)}
@keyframes spin{to{transform:rotate(360deg)}}
@keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.7;transform:scale(.97)}}
@keyframes fadeUp{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}
@keyframes slideUp{from{transform:translateY(100%)}to{transform:none}}
@keyframes scaleIn{from{opacity:0;transform:scale(.95)}to{opacity:1;transform:scale(1)}}
@keyframes shimmer{0%{background-position:-200% 0}100%{background-position:200% 0}}
@keyframes goldGlow{0%,100%{box-shadow:0 0 20px rgba(212,175,55,.2)}50%{box-shadow:0 0 40px rgba(212,175,55,.4),0 0 80px rgba(212,175,55,.15)}}
@keyframes confettiFall{0%{transform:translateY(-100vh) rotate(0deg);opacity:1}100%{transform:translateY(100vh) rotate(720deg);opacity:0}}
@keyframes bounceIn{0%{transform:scale(0);opacity:0}50%{transform:scale(1.05)}100%{transform:scale(1);opacity:1}}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-6px)}}
@keyframes skeletonShine{0%{background-position:-200% 0}100%{background-position:200% 0}}
@keyframes checkmark{0%{stroke-dashoffset:50}100%{stroke-dashoffset:0}}

/* Glass */
.glass{background:var(--surface);backdrop-filter:blur(32px) saturate(180%);-webkit-backdrop-filter:blur(32px) saturate(180%);border:1px solid var(--border);border-radius:var(--radius)}
.glass-gold{background:var(--surface);backdrop-filter:blur(32px) saturate(180%);-webkit-backdrop-filter:blur(32px) saturate(180%);border:1px solid var(--border-2);border-radius:var(--radius);animation:goldGlow 3s ease-in-out infinite}

/* Top bar */
.topbar{position:sticky;top:0;z-index:50;display:flex;align-items:center;justify-content:space-between;padding:14px 18px;padding-top:calc(14px + env(safe-area-inset-top));background:rgba(0,0,0,.6);backdrop-filter:blur(24px);-webkit-backdrop-filter:blur(24px);border-bottom:1px solid var(--border)}
.brand{display:flex;align-items:center;gap:10px;font-weight:800;font-size:20px;letter-spacing:-.5px}
.brand-mark{width:34px;height:34px;border-radius:10px;background:linear-gradient(135deg,#1c1c1e,#000);display:flex;align-items:center;justify-content:center;color:var(--gold);font-weight:800;border:1px solid var(--border-2);box-shadow:0 4px 20px rgba(212,175,55,.15)}
.topbar-actions{display:flex;gap:8px;align-items:center}
.icon-btn{width:40px;height:40px;border-radius:12px;display:flex;align-items:center;justify-content:center;background:var(--surface-2);border:1px solid var(--border);transition:transform .2s var(--ease),background .2s}
.icon-btn:hover{background:rgba(255,255,255,.08)}
.icon-btn:active{transform:scale(.92)}
.badge{position:absolute;top:-4px;right:-4px;min-width:18px;height:18px;background:var(--danger);color:#fff;font-size:10px;font-weight:700;border-radius:9px;display:flex;align-items:center;justify-content:center;padding:0 5px;border:2px solid #000}
.icon-wrap{position:relative}

/* Main */
.app{padding:18px 18px 110px;max-width:1100px;margin:0 auto;animation:fadeIn .4s var(--ease)}
.page{animation:fadeUp .35s var(--ease)}

/* Hero / banner slider */
.hero{border-radius:22px;overflow:hidden;position:relative;margin-bottom:22px;min-height:420px;background:#000;border:1px solid var(--border-2);isolation:isolate}
.hero-video{position:absolute;top:50%;left:50%;width:120%;height:120%;object-fit:cover;transform:translate(-50%,-50%) translateZ(0);z-index:0;opacity:.45;will-change:transform;backface-visibility:hidden;-webkit-backface-visibility:hidden;transform-style:preserve-3d;transition:opacity 1.2s ease}
@media(prefers-reduced-motion:reduce){.hero-video{display:none}}
.hero-overlay{position:absolute;inset:0;background:radial-gradient(ellipse 80% 50% at 50% 0%,rgba(212,175,55,.13),transparent 60%),radial-gradient(ellipse 60% 40% at 20% 80%,rgba(212,175,55,.07),transparent 55%),linear-gradient(180deg,rgba(0,0,0,.08),rgba(0,0,0,.68));z-index:1}
.gold-particles{position:absolute;inset:0;pointer-events:none;z-index:2;overflow:hidden}
.particle{position:absolute;border-radius:50%;background:radial-gradient(circle,rgba(240,215,140,.95) 0%,rgba(212,175,55,.5) 45%,transparent 75%);animation:floatGold linear infinite;filter:blur(.3px);transform:translateZ(0);will-change:transform,opacity;backface-visibility:hidden;-webkit-backface-visibility:hidden;pointer-events:none}
@keyframes floatGold{0%{transform:translateY(0) translateX(0) scale(.6) translateZ(0);opacity:0}8%{opacity:.9}90%{opacity:.7}100%{transform:translateY(-460px) translateX(40px) scale(1) translateZ(0);opacity:0}}
@media(prefers-reduced-motion:reduce){.particle{animation:none!important;display:none!important}}
.hero-content{position:relative;z-index:5}
.hero-slides{display:flex;transition:transform .6s var(--ease);height:100%}
.hero-slide{min-width:100%;height:100%;display:flex;flex-direction:column;justify-content:flex-end;padding:24px;position:relative;background-size:cover;background-position:center}
.hero-slide::before{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent 40%,rgba(0,0,0,.85))}
.hero-slide>*{position:relative;z-index:1}
.hero-tag{display:inline-block;padding:6px 12px;background:rgba(212,175,55,.18);border:1px solid var(--border-2);border-radius:999px;font-size:11px;font-weight:600;color:var(--gold);letter-spacing:.5px;text-transform:uppercase;margin-bottom:10px;width:fit-content}
.hero-title{font-size:clamp(22px,4vw,32px);font-weight:800;letter-spacing:-.5px;margin:0 0 6px;max-width:80%}
.hero-sub{color:var(--text-2);font-size:14px;margin:0;max-width:80%}
.hero-dots{position:absolute;bottom:14px;right:18px;display:flex;gap:6px;z-index:2}
.hero-dot{width:6px;height:6px;border-radius:3px;background:rgba(255,255,255,.4);transition:all .3s}
.hero-dot.active{width:22px;background:var(--gold)}

/* Flash sale */
.flash{display:flex;align-items:center;justify-content:space-between;padding:14px 18px;margin-bottom:18px;border-radius:16px;background:linear-gradient(135deg,rgba(255,69,58,.15),rgba(212,175,55,.08));border:1px solid rgba(255,69,58,.25)}
.flash-left{display:flex;align-items:center;gap:10px}
.flash-icon{width:36px;height:36px;border-radius:10px;display:flex;align-items:center;justify-content:center;background:rgba(255,69,58,.2);font-size:18px}
.flash-title{font-weight:700;font-size:14px}
.flash-sub{font-size:12px;color:var(--text-2)}
.flash-timer{display:flex;gap:4px}
.flash-cell{background:#000;border:1px solid var(--border);border-radius:8px;padding:6px 9px;min-width:34px;text-align:center;font-weight:700;font-size:13px;font-variant-numeric:tabular-nums}

/* Section header */
.section-header{display:flex;align-items:center;justify-content:space-between;margin:24px 4px 14px}
.section-title{font-size:18px;font-weight:700;letter-spacing:-.3px;margin:0}
.section-link{font-size:13px;color:var(--gold);font-weight:500}

/* Search */
.search-bar{display:flex;align-items:center;gap:10px;padding:12px 16px;background:var(--surface);border:1px solid var(--border);border-radius:14px;margin-bottom:18px;transition:border-color .2s}
.search-bar:focus-within{border-color:var(--gold)}
.search-bar svg{flex:0 0 18px;color:var(--text-2)}
.search-bar input{flex:1;font-size:15px}
.filter-chips{display:flex;gap:8px;overflow-x:auto;padding-bottom:6px;margin-bottom:16px;scrollbar-width:none}
.filter-chips::-webkit-scrollbar{display:none}
.chip{flex:0 0 auto;padding:8px 14px;background:var(--surface-2);border:1px solid var(--border);border-radius:999px;font-size:13px;font-weight:500;color:var(--text-2);transition:all .2s var(--ease);white-space:nowrap}
.chip.active{background:var(--gold);color:#000;border-color:var(--gold);font-weight:600}
.chip:active{transform:scale(.95)}

/* Sort */
.sort-row{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;font-size:13px;color:var(--text-2)}
.sort-select{padding:6px 10px;background:var(--surface-2);border:1px solid var(--border);border-radius:10px;color:var(--text);font-size:13px;width:auto;cursor:pointer}

/* Product grid */
.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
@media(min-width:640px){.grid{grid-template-columns:repeat(3,1fr);gap:14px}}
@media(min-width:900px){.grid{grid-template-columns:repeat(4,1fr);gap:16px}}
.card{background:var(--surface);border:1px solid var(--border);border-radius:18px;overflow:hidden;display:flex;flex-direction:column;transition:transform .25s var(--ease),border-color .25s,box-shadow .25s;position:relative}
.card:hover{transform:translateY(-3px);border-color:var(--border-2);box-shadow:0 8px 30px rgba(212,175,55,.1)}
.card-img{aspect-ratio:1;background:#111 center/cover no-repeat;position:relative;overflow:hidden}
.card-img::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent 60%,rgba(0,0,0,.4))}
.card-fav{position:absolute;top:8px;right:8px;width:32px;height:32px;border-radius:16px;background:rgba(0,0,0,.55);backdrop-filter:blur(10px);display:flex;align-items:center;justify-content:center;z-index:2;transition:transform .2s}
.card-fav.active{color:var(--danger)}
.card-fav:active{transform:scale(.85)}
.card-stock{position:absolute;top:8px;left:8px;padding:4px 8px;background:rgba(48,209,88,.2);border:1px solid rgba(48,209,88,.4);border-radius:8px;font-size:10px;font-weight:600;color:var(--success);z-index:2}
.card-stock.out{background:rgba(255,69,58,.2);border-color:rgba(255,69,58,.4);color:var(--danger)}
.card-body{padding:12px;display:flex;flex-direction:column;gap:6px;flex:1}
.card-title{font-size:14px;font-weight:600;line-height:1.3;margin:0;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;min-height:36px}
.card-rating{display:flex;align-items:center;gap:4px;font-size:11px;color:var(--text-2)}
.card-rating .star{color:var(--gold)}
.card-bottom{display:flex;align-items:center;justify-content:space-between;margin-top:auto;padding-top:6px}
.card-price{font-size:16px;font-weight:700;color:var(--gold)}
.card-price small{font-size:11px;color:var(--muted);font-weight:400;text-decoration:line-through;margin-left:4px}
.add-btn{width:32px;height:32px;border-radius:10px;background:var(--gold);color:#000;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:18px;transition:transform .15s}
.add-btn:active{transform:scale(.85)}

/* Skeleton loading */
.skeleton{background:linear-gradient(90deg,rgba(255,255,255,.05) 0%,rgba(255,255,255,.1) 50%,rgba(255,255,255,.05) 100%);background-size:200% 100%;animation:shimmer 2s infinite}
.skeleton-card{border-radius:18px;overflow:hidden}
.skeleton-card .skeleton-img{aspect-ratio:1;background:linear-gradient(90deg,rgba(255,255,255,.05) 0%,rgba(255,255,255,.1) 50%,rgba(255,255,255,.05) 100%);background-size:200% 100%;animation:shimmer 2s infinite}
.skeleton-card .skeleton-text{height:12px;background:linear-gradient(90deg,rgba(255,255,255,.05) 0%,rgba(255,255,255,.1) 50%,rgba(255,255,255,.05) 100%);background-size:200% 100%;animation:shimmer 2s infinite;border-radius:6px;margin:8px 0}

/* Bottom nav */
.bottom-nav{position:fixed;bottom:0;left:0;right:0;z-index:60;display:flex;justify-content:space-around;padding:8px 8px calc(8px + env(safe-area-inset-bottom));background:rgba(10,10,10,.85);backdrop-filter:blur(28px);-webkit-backdrop-filter:blur(28px);border-top:1px solid var(--border)}
.nav-item{flex:1;display:flex;flex-direction:column;align-items:center;gap:3px;padding:8px 4px;color:var(--text-2);font-size:10px;font-weight:500;border-radius:12px;transition:color .2s;position:relative}
.nav-item.active{color:var(--gold)}
.nav-item svg{width:22px;height:22px}
.nav-item.active::before{content:"";position:absolute;top:0;left:50%;transform:translateX(-50%);width:24px;height:2px;background:var(--gold);border-radius:2px}

/* Buttons */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:13px 18px;border-radius:14px;font-weight:600;font-size:15px;transition:transform .15s var(--ease),opacity .2s;width:100%}
.btn:active{transform:scale(.97)}
.btn-primary{background:linear-gradient(135deg,var(--gold),var(--gold-2));color:#000;box-shadow:0 6px 24px rgba(212,175,55,.3)}
.btn-secondary{background:var(--surface-2);border:1px solid var(--border);color:var(--text)}
.btn-danger{background:rgba(255,69,58,.15);border:1px solid rgba(255,69,58,.35);color:var(--danger)}
.btn-success{background:rgba(48,209,88,.15);border:1px solid rgba(48,209,88,.35);color:var(--success)}
.btn-ghost{background:transparent;color:var(--text-2)}
.btn:disabled{opacity:.5;pointer-events:none}

/* Auth */
.auth-screen{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:18px}
.auth-card{padding:32px;max-width:420px;width:100%;animation:scaleIn .4s var(--ease)}
.auth-logo{text-align:center;margin-bottom:28px}
.auth-logo .brand-mark{margin:0 auto 12px;width:56px;height:56px;font-size:28px}
.auth-logo h1{font-size:28px;font-weight:800;margin:0;letter-spacing:-.5px}
.auth-logo h1 .gold{color:var(--gold)}
.auth-logo p{color:var(--text-2);font-size:13px;margin:6px 0 0}
.auth-tabs{display:flex;gap:8px;margin-bottom:24px;border-bottom:1px solid var(--border);padding-bottom:12px}
.auth-tab{flex:1;padding:10px;border:none;background:none;color:var(--text-2);font-weight:600;font-size:14px;cursor:pointer;border-bottom:2px solid transparent;transition:all .2s}
.auth-tab.active{color:var(--gold);border-bottom-color:var(--gold)}
.field{margin-bottom:16px}
.field-label{display:block;font-size:13px;font-weight:600;color:var(--text);margin-bottom:8px}
.input-wrap{position:relative;display:flex;align-items:center;gap:8px;padding:12px 14px;background:var(--surface-2);border:1px solid var(--border);border-radius:12px;transition:border-color .2s}
.input-wrap:focus-within{border-color:var(--gold)}
.input-wrap svg{flex:0 0 18px;color:var(--text-2)}
.input-wrap input,.input-wrap textarea{flex:1}
.eye-btn{background:none;border:none;color:var(--text-2);cursor:pointer;font-size:16px;padding:0}
.remember-row{display:flex;align-items:center;gap:8px;font-size:13px;margin-bottom:16px}
.remember-row input{width:auto}
.pwd-strength{height:3px;background:var(--surface-2);border-radius:2px;overflow:hidden;margin-top:6px}
.pwd-strength-bar{height:100%;width:0;transition:width .3s,background .3s}
.text-c{text-align:center}
.muted{color:var(--text-2)}
.fz12{font-size:12px}
.mt-12{margin-top:12px}
.gold{color:var(--gold)}

/* Toast */
#toast-host{position:fixed;top:calc(60px + env(safe-area-inset-top));right:18px;z-index:1000;display:flex;flex-direction:column;gap:8px;pointer-events:none}
.toast{display:flex;align-items:center;gap:8px;padding:12px 16px;background:var(--surface-2);border:1px solid var(--border);border-radius:12px;font-size:13px;font-weight:500;animation:slideUp .3s var(--ease);pointer-events:auto;cursor:pointer;transition:opacity .3s,transform .3s}
.toast.success{border-color:rgba(48,209,88,.3);background:rgba(48,209,88,.1)}
.toast.error{border-color:rgba(255,69,58,.3);background:rgba(255,69,58,.1)}
.toast.info{border-color:rgba(10,132,255,.3);background:rgba(10,132,255,.1)}

/* Modal */
.modal-backdrop{position:fixed;inset:0;background:rgba(0,0,0,.7);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);display:flex;align-items:center;justify-content:center;z-index:100;padding:18px;animation:fadeIn .2s var(--ease)}
.modal{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);width:100%;max-width:500px;max-height:90vh;display:flex;flex-direction:column;animation:scaleIn .3s var(--ease)}
.modal-head{display:flex;align-items:center;justify-content:space-between;padding:18px;border-bottom:1px solid var(--border)}
.modal-title{font-weight:700;font-size:16px}
.close-btn{width:32px;height:32px;border-radius:8px;display:flex;align-items:center;justify-content:center;background:var(--surface-2);border:1px solid var(--border);cursor:pointer;transition:all .2s;font-size:18px}
.close-btn:hover{background:rgba(255,255,255,.1)}
.modal-body{flex:1;overflow-y:auto;padding:18px}
.modal-foot{display:flex;gap:8px;padding:18px;border-top:1px solid var(--border)}
.modal-foot .btn{flex:1}

/* Chat */
.chat-fab{position:fixed;bottom:calc(70px + env(safe-area-inset-bottom));right:18px;width:56px;height:56px;border-radius:28px;background:linear-gradient(135deg,var(--gold),var(--gold-2));color:#000;display:flex;align-items:center;justify-content:center;box-shadow:0 6px 24px rgba(212,175,55,.3);z-index:55;transition:transform .2s;cursor:pointer}
.chat-fab:active{transform:scale(.9)}
.chat-fab.hidden{display:none}
.chat-panel{position:fixed;bottom:calc(70px + env(safe-area-inset-bottom));right:18px;width:320px;height:420px;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);display:flex;flex-direction:column;z-index:55;transform:translateY(100%);transition:transform .3s var(--ease);pointer-events:none}
.chat-panel.show{transform:translateY(0);pointer-events:auto}
.chat-msgs{flex:1;overflow-y:auto;padding:14px;display:flex;flex-direction:column;gap:8px}
.chat-msg{padding:10px 12px;border-radius:10px;font-size:13px;max-width:85%;word-wrap:break-word}
.chat-msg.me{background:var(--gold);color:#000;align-self:flex-end}
.chat-msg.bot{background:var(--surface-2);align-self:flex-start}
.chat-input{display:flex;gap:8px;padding:12px;border-top:1px solid var(--border)}
.chat-input input{flex:1;padding:8px 12px;background:var(--surface-2);border:1px solid var(--border);border-radius:8px;font-size:13px}

/* Confetti */
.confetti-container{position:fixed;inset:0;pointer-events:none;z-index:1000}
.confetti-piece{position:absolute;animation:confettiFall linear forwards}

/* Product page */
.pd-img{aspect-ratio:1;background:#111 center/cover no-repeat;border-radius:18px;margin-bottom:16px;border:1px solid var(--border)}
.pd-title{font-size:24px;font-weight:800;letter-spacing:-.5px;margin:0}
.pd-price{font-size:28px;font-weight:800;color:var(--gold);margin:12px 0}
.pd-price small{font-size:14px;color:var(--muted);font-weight:400;text-decoration:line-through;margin-left:8px}
.pd-desc{color:var(--text-2);line-height:1.6;margin:12px 0}
.row{display:flex;gap:8px;margin:12px 0}
.row .btn{flex:1}
.divider{height:1px;background:var(--border);margin:18px 0}

/* Cart */
.cart-item{display:flex;gap:12px;padding:12px;background:var(--surface);border:1px solid var(--border);border-radius:12px;margin-bottom:8px}
.cart-item-img{width:60px;height:60px;background:#111 center/cover no-repeat;border-radius:8px;flex-shrink:0}
.cart-item-body{flex:1;display:flex;flex-direction:column;justify-content:space-between}
.cart-item-title{font-weight:600;font-size:13px}
.cart-item-price{color:var(--gold);font-weight:700;font-size:14px}
.qty-control{display:flex;align-items:center;gap:6px;width:fit-content}
.qty-btn{width:24px;height:24px;border-radius:6px;background:var(--surface-2);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:12px;cursor:pointer;transition:all .2s}
.qty-btn:active{transform:scale(.85)}

/* Wallet */
.wallet-card{padding:18px;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);margin-bottom:16px}
.wallet-label{font-size:12px;color:var(--text-2);font-weight:600}
.wallet-bal{font-size:32px;font-weight:800;color:var(--gold);margin:8px 0}
.stat-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin:16px 0}
.stat{padding:14px;background:var(--surface);border:1px solid var(--border);border-radius:12px;text-align:center}
.stat-label{font-size:12px;color:var(--text-2);font-weight:600}
.stat-val{font-size:20px;font-weight:800;margin-top:6px}
.stat-val.gold{color:var(--gold)}

/* Orders */
.order-item{padding:14px;background:var(--surface);border:1px solid var(--border);border-radius:12px;margin-bottom:8px}
.order-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}
.order-id{font-weight:700}
.status-pill{display:inline-block;padding:4px 10px;border-radius:8px;font-size:11px;font-weight:600}
.status-pending{background:rgba(255,159,10,.15);color:#ff9f0a}
.status-completed{background:rgba(48,209,88,.15);color:var(--success)}
.status-approved{background:rgba(48,209,88,.15);color:var(--success)}
.status-rejected{background:rgba(255,69,58,.15);color:var(--danger)}
.status-verifying{background:rgba(10,132,255,.15);color:#0a84ff}

/* Admin */
.tabs{display:flex;gap:8px;overflow-x:auto;margin-bottom:16px;padding-bottom:8px;border-bottom:1px solid var(--border)}
.tab{flex:0 0 auto;padding:8px 14px;background:transparent;border:1px solid var(--border);border-radius:10px;color:var(--text-2);font-weight:600;font-size:13px;cursor:pointer;transition:all .2s;white-space:nowrap}
.tab.active{background:var(--gold);color:#000;border-color:var(--gold)}
.list-item{display:flex;align-items:center;gap:12px;padding:12px;background:var(--surface);border:1px solid var(--border);border-radius:12px;margin-bottom:8px}
.list-img{width:48px;height:48px;background:#111 center/cover no-repeat;border-radius:8px;flex-shrink:0}
.list-body{flex:1;min-width:0}
.list-title{font-weight:600;font-size:13px;margin:0}
.list-sub{font-size:11px;color:var(--text-2);margin:4px 0 0}
.avatar{width:44px;height:44px;border-radius:10px;background:var(--gold);color:#000;display:flex;align-items:center;justify-content:center;font-weight:700;flex-shrink:0}
.menu-item{width:100%;display:flex;align-items:center;gap:12px;padding:14px;background:var(--surface);border:1px solid var(--border);border-radius:12px;margin-bottom:8px;cursor:pointer;transition:all .2s}
.menu-item:hover{border-color:var(--border-2)}
.menu-item svg{width:20px;height:20px;flex-shrink:0;color:var(--text-2)}
.menu-item-text{flex:1;font-weight:600;font-size:14px}
.menu-item-arr{color:var(--text-2);font-size:16px}
.menu-item.gold .menu-item-text{color:var(--gold)}

/* Empty state */
.empty{text-align:center;padding:40px 18px}
.empty-icon{font-size:48px;margin-bottom:12px}
.empty p{color:var(--text-2);font-size:14px;margin:0}

/* FAQ */
.faq-item{padding:14px;background:var(--surface);border:1px solid var(--border);border-radius:12px;margin-bottom:8px;cursor:pointer;transition:all .2s}
.faq-item.open{border-color:var(--gold)}
.faq-q{display:flex;justify-content:space-between;align-items:center;font-weight:600;font-size:13px}
.faq-arrow{transition:transform .3s;display:inline-block}
.faq-item.open .faq-arrow{transform:rotate(180deg)}
.faq-a{font-size:12px;color:var(--text-2);line-height:1.6;margin-top:8px;display:none}
.faq-item.open .faq-a{display:block}

/* Review */
.review-item{padding:12px;background:var(--surface-2);border:1px solid var(--border);border-radius:10px;margin-bottom:8px}
.review-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:6px}
.review-name{font-weight:600;font-size:13px}
.verified-badge{display:inline-block;margin-left:6px;padding:2px 6px;background:rgba(48,209,88,.2);border:1px solid rgba(48,209,88,.4);border-radius:4px;font-size:10px;color:var(--success)}
.review-stars{font-size:12px;color:var(--gold)}
.review-text{font-size:12px;color:var(--text-2);line-height:1.5;margin:6px 0}
.helpful-btn{background:none;border:none;color:var(--text-2);font-size:12px;cursor:pointer;padding:0;margin-top:6px}

/* Rating bars */
.rating-bars{margin:12px 0}
.rating-bar-row{display:flex;align-items:center;gap:8px;font-size:12px;margin-bottom:6px}
.rating-bar-track{flex:1;height:4px;background:var(--surface-2);border-radius:2px;overflow:hidden}
.rating-bar-fill{height:100%;background:var(--gold)}

/* Responsive */
@media(max-width:768px){
  .hero{min-height:300px}
  .hero-title{font-size:22px}
  .grid{grid-template-columns:repeat(2,1fr);gap:10px}
  .modal{max-width:90vw}
  .chat-panel{width:100%;right:0;left:0;border-radius:18px 18px 0 0}
  .chat-fab{right:18px}
}

/* Admin drag-drop */
.upload-zone{border:2px dashed var(--border-2);border-radius:12px;padding:24px;text-align:center;cursor:pointer;transition:all .2s}
.upload-zone:hover{border-color:var(--gold);background:rgba(212,175,55,.05)}
.upload-zone.dragover{border-color:var(--gold);background:rgba(212,175,55,.1)}
.upload-zone svg{width:32px;height:32px;margin:0 auto 8px;color:var(--text-2)}

/* Product preview grid */
.product-preview-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(100px,1fr));gap:8px;margin:12px 0}
.preview-item{aspect-ratio:1;background:#111 center/cover no-repeat;border-radius:8px;border:1px solid var(--border);cursor:pointer;transition:all .2s}
.preview-item:hover{border-color:var(--gold)}

/* Stock manager */
.stock-list{max-height:200px;overflow-y:auto;margin:8px 0}
.stock-item{display:flex;justify-content:space-between;align-items:center;padding:8px;background:var(--surface-2);border:1px solid var(--border);border-radius:8px;margin-bottom:4px;font-size:12px}
.stock-remove{background:rgba(255,69,58,.2);color:var(--danger);border:none;padding:2px 6px;border-radius:4px;cursor:pointer;font-size:10px}

/* Category manager */
.category-list{display:grid;grid-template-columns:repeat(auto-fill,minmax(100px,1fr));gap:8px;margin:12px 0}
.category-item{padding:10px;background:var(--surface);border:1px solid var(--border);border-radius:8px;text-align:center;font-size:12px;cursor:pointer;transition:all .2s}
.category-item:hover{border-color:var(--gold)}
.category-item.active{background:var(--gold);color:#000}

/* Chart wrapper */
.chart-wrap{padding:16px;background:var(--surface);border:1px solid var(--border);border-radius:12px;margin-bottom:12px}

/* Profile */
.profile-head{display:flex;gap:12px;align-items:flex-start;padding:16px;background:var(--surface);border:1px solid var(--border);border-radius:12px;margin-bottom:16px}
.profile-head .avatar{width:56px;height:56px;font-size:20px}
.profile-head button{flex-shrink:0}

/* Deposit pipeline */
.deposit-pipeline{display:flex;align-items:center;gap:8px;font-size:11px}
.pipeline-step{display:flex;flex-direction:column;align-items:center;gap:4px}
.pipeline-dot{width:24px;height:24px;border-radius:50%;background:var(--surface-2);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:600;color:var(--text-2)}
.pipeline-dot.active{background:var(--gold);color:#000;border-color:var(--gold)}
.pipeline-dot.done{background:var(--success);color:#fff;border-color:var(--success)}
.pipeline-line{flex:1;height:2px;background:var(--border)}
.pipeline-line.done{background:var(--success)}
.pipeline-label{font-size:10px;color:var(--text-2);text-align:center;white-space:nowrap}

/* Crypto grid */
.crypto-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:10px;margin:12px 0}
.crypto-card{padding:12px;background:var(--surface);border:1px solid var(--border);border-radius:12px;text-align:center;cursor:pointer;transition:all .2s}
.crypto-card:hover{border-color:var(--gold)}
.crypto-card.active{border-color:var(--gold);background:rgba(212,175,55,.1)}
.crypto-name{font-weight:600;font-size:12px;margin:4px 0 0}
.crypto-net{font-size:10px;color:var(--text-2)}

/* Ticket */
.ticket-item{padding:12px;background:var(--surface);border:1px solid var(--border);border-radius:12px;margin-bottom:8px;cursor:pointer;transition:all .2s}
.ticket-item:hover{border-color:var(--gold)}
.ticket-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:6px}

/* ============================================================
   PREMIUM v2 OVERLAY — cinematic luxury polish (additive only)
   ============================================================ */
:root{
  --gold-3:#ffe7a0;
  --liquid:linear-gradient(135deg,rgba(255,255,255,.08),rgba(255,255,255,.02) 40%,rgba(212,175,55,.06));
  --ease-out:cubic-bezier(.16,1,.3,1);
  --ease-spring:cubic-bezier(.34,1.56,.64,1);
  --shadow-gold:0 8px 32px rgba(212,175,55,.18),0 2px 8px rgba(212,175,55,.12);
  --shadow-deep:0 20px 60px rgba(0,0,0,.6),0 4px 16px rgba(0,0,0,.4);
}
html{scroll-behavior:smooth}
body{
  background:
    radial-gradient(1400px 900px at 80% -15%,rgba(212,175,55,.10),transparent 60%),
    radial-gradient(1000px 700px at -15% 110%,rgba(212,175,55,.06),transparent 60%),
    radial-gradient(800px 500px at 50% 50%,rgba(212,175,55,.025),transparent 70%),
    #000;
}
::selection{background:rgba(212,175,55,.35);color:#fff}

/* Premium loader v2 — cinematic */
#loader{background:radial-gradient(circle at 50% 50%,#0a0a0a,#000 70%)}
.loader-logo{
  background:linear-gradient(120deg,var(--gold) 0%,var(--gold-3) 30%,var(--gold) 60%,var(--gold-2) 100%);
  background-size:300% 100%;
  -webkit-background-clip:text;background-clip:text;color:transparent;
  animation:loaderShine 2.4s ease-in-out infinite;
  filter:drop-shadow(0 4px 24px rgba(212,175,55,.4));
}
@keyframes loaderShine{0%,100%{background-position:0% 50%}50%{background-position:100% 50%}}
.loader-ring{box-shadow:0 0 60px rgba(212,175,55,.35),inset 0 0 20px rgba(212,175,55,.1)}

/* Page transition */
.page{animation:pageEnter .55s var(--ease-out)}
@keyframes pageEnter{
  from{opacity:0;transform:translateY(14px) scale(.985);filter:blur(6px)}
  to{opacity:1;transform:none;filter:blur(0)}
}

/* Premium glassmorphism — liquid glass */
.glass,.modal,.wallet-card,.cart-item,.order-item,.list-item,.menu-item,.faq-item,
.card,.flash,.stat,.chart-wrap,.profile-head,.crypto-card,.ticket-item,.auth-card,
.search-bar,.input-wrap,.review-item{
  background:linear-gradient(135deg,rgba(24,24,28,.78),rgba(14,14,18,.72));
  backdrop-filter:blur(28px) saturate(180%);
  -webkit-backdrop-filter:blur(28px) saturate(180%);
}
.card,.menu-item,.list-item,.stat,.crypto-card{position:relative;overflow:hidden}
.card::before,.menu-item::before,.list-item::before,.stat::before,.crypto-card::before{
  content:"";position:absolute;inset:0;border-radius:inherit;pointer-events:none;
  background:linear-gradient(135deg,rgba(255,255,255,.06),transparent 35%);
  z-index:1;
}
.card>*,.menu-item>*,.list-item>*,.stat>*,.crypto-card>*{position:relative;z-index:2}

/* 3D glowing premium buttons */
.btn{
  letter-spacing:.2px;
  transition:transform .25s var(--ease-spring),box-shadow .3s var(--ease-out),filter .25s;
  position:relative;overflow:hidden;
}
.btn::after{
  content:"";position:absolute;inset:0;border-radius:inherit;pointer-events:none;
  background:linear-gradient(120deg,transparent 30%,rgba(255,255,255,.22),transparent 70%);
  transform:translateX(-120%);transition:transform .8s var(--ease-out);
}
.btn:hover::after{transform:translateX(120%)}
.btn-primary{
  background:linear-gradient(135deg,#f0d78c 0%,var(--gold) 50%,#b8932c 100%);
  box-shadow:
    0 10px 30px rgba(212,175,55,.35),
    0 2px 0 rgba(255,255,255,.25) inset,
    0 -2px 0 rgba(0,0,0,.2) inset;
  text-shadow:0 1px 0 rgba(255,255,255,.2);
}
.btn-primary:hover{transform:translateY(-2px);box-shadow:0 14px 40px rgba(212,175,55,.5),0 2px 0 rgba(255,255,255,.3) inset}
.btn-secondary:hover{border-color:var(--border-2);background:rgba(255,255,255,.05)}

/* Cards — premium hover */
.card{transition:transform .35s var(--ease-out),border-color .35s,box-shadow .35s,background .35s}
.card:hover{
  transform:translateY(-6px) scale(1.01);
  border-color:rgba(212,175,55,.45);
  box-shadow:var(--shadow-gold),var(--shadow-deep);
}
.card-img{transition:transform .6s var(--ease-out)}
.card:hover .card-img{transform:scale(1.06)}
.add-btn{
  background:linear-gradient(135deg,var(--gold-2),var(--gold));
  box-shadow:0 4px 14px rgba(212,175,55,.4),0 1px 0 rgba(255,255,255,.3) inset;
  transition:transform .2s var(--ease-spring),box-shadow .2s;
}
.add-btn:hover{transform:scale(1.1) rotate(90deg);box-shadow:0 6px 20px rgba(212,175,55,.6)}

/* Brand mark — premium */
.brand-mark{
  background:linear-gradient(135deg,#1c1c1e,#000);
  box-shadow:0 4px 20px rgba(212,175,55,.25),0 1px 0 rgba(255,255,255,.08) inset;
  position:relative;
}
.brand-mark::after{
  content:"";position:absolute;inset:-1px;border-radius:inherit;padding:1px;
  background:linear-gradient(135deg,rgba(212,175,55,.5),transparent 50%,rgba(212,175,55,.3));
  -webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);
  -webkit-mask-composite:xor;mask-composite:exclude;pointer-events:none;
}

/* Hero — more cinematic */
.hero{box-shadow:var(--shadow-deep);border-color:rgba(212,175,55,.3)}
.hero-title{
  background:linear-gradient(180deg,#fff 0%,#e5e5e7 60%,#a1a1a6 100%);
  -webkit-background-clip:text;background-clip:text;color:transparent;
  text-shadow:0 2px 30px rgba(212,175,55,.15);
}
.hero-tag{
  background:linear-gradient(135deg,rgba(212,175,55,.25),rgba(212,175,55,.1));
  box-shadow:0 2px 12px rgba(212,175,55,.15),0 1px 0 rgba(255,255,255,.08) inset;
}

/* Bottom nav — premium */
.bottom-nav{
  background:linear-gradient(180deg,rgba(10,10,12,.7),rgba(0,0,0,.92));
  backdrop-filter:blur(40px) saturate(180%);
  -webkit-backdrop-filter:blur(40px) saturate(180%);
  box-shadow:0 -10px 40px rgba(0,0,0,.5);
}
.nav-item{transition:color .25s,transform .25s var(--ease-spring)}
.nav-item:active{transform:scale(.92)}
.nav-item.active svg{filter:drop-shadow(0 2px 8px rgba(212,175,55,.6))}

/* Topbar — premium */
.topbar{
  background:linear-gradient(180deg,rgba(0,0,0,.82),rgba(0,0,0,.55));
  backdrop-filter:blur(36px) saturate(180%);
  -webkit-backdrop-filter:blur(36px) saturate(180%);
}
.icon-btn{transition:transform .2s var(--ease-spring),background .2s,box-shadow .2s}
.icon-btn:hover{background:rgba(255,255,255,.08);box-shadow:0 4px 14px rgba(212,175,55,.15)}

/* Wallet balance — premium */
.wallet-bal{
  background:linear-gradient(135deg,var(--gold-3),var(--gold) 50%,var(--gold-2));
  -webkit-background-clip:text;background-clip:text;color:transparent;
  filter:drop-shadow(0 2px 16px rgba(212,175,55,.3));
  letter-spacing:-1px;
}

/* Toast — premium */
.toast{
  backdrop-filter:blur(24px) saturate(180%);
  -webkit-backdrop-filter:blur(24px) saturate(180%);
  box-shadow:var(--shadow-deep);
  border-radius:14px;
  animation:toastIn .45s var(--ease-spring);
}
@keyframes toastIn{from{transform:translateX(120%) scale(.9);opacity:0}to{transform:none;opacity:1}}

/* Live purchase popup */
.live-pop{
  position:fixed;left:18px;bottom:calc(80px + env(safe-area-inset-bottom));
  z-index:70;max-width:280px;
  display:flex;gap:10px;align-items:center;padding:10px 14px 10px 10px;
  background:linear-gradient(135deg,rgba(24,24,28,.92),rgba(14,14,18,.88));
  backdrop-filter:blur(28px) saturate(180%);
  -webkit-backdrop-filter:blur(28px) saturate(180%);
  border:1px solid rgba(212,175,55,.28);
  border-radius:14px;
  box-shadow:var(--shadow-deep),0 0 24px rgba(212,175,55,.12);
  transform:translateX(-130%);opacity:0;
  transition:transform .55s var(--ease-spring),opacity .4s;
  pointer-events:none;
}
.live-pop.show{transform:none;opacity:1}
.live-pop-av{
  width:36px;height:36px;border-radius:10px;flex-shrink:0;
  background:linear-gradient(135deg,var(--gold),#8b6f1f);
  color:#000;font-weight:800;font-size:13px;
  display:flex;align-items:center;justify-content:center;
  box-shadow:0 2px 10px rgba(212,175,55,.4);
}
.live-pop-body{min-width:0;line-height:1.3}
.live-pop-name{font-size:12px;font-weight:700;color:#fff}
.live-pop-prod{font-size:11px;color:var(--text-2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.live-pop-time{font-size:10px;color:var(--gold);margin-top:2px;font-weight:600}

/* Live visitor pill */
.live-visitors{
  display:inline-flex;align-items:center;gap:6px;
  padding:5px 10px;border-radius:999px;
  background:rgba(48,209,88,.12);border:1px solid rgba(48,209,88,.3);
  font-size:11px;font-weight:600;color:var(--success);
  margin:8px 4px 12px;
}
.live-dot{width:6px;height:6px;border-radius:50%;background:var(--success);box-shadow:0 0 8px var(--success);animation:livePulse 1.6s ease-in-out infinite}
@keyframes livePulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.55;transform:scale(.8)}}

/* Trust badges row */
.trust-row{display:flex;gap:8px;overflow-x:auto;margin:6px 0 14px;scrollbar-width:none}
.trust-row::-webkit-scrollbar{display:none}
.trust-chip{
  flex:0 0 auto;display:inline-flex;align-items:center;gap:6px;
  padding:6px 12px;border-radius:999px;font-size:11px;font-weight:600;
  background:rgba(255,255,255,.04);border:1px solid var(--border);color:var(--text-2);
}
.trust-chip svg{width:13px;height:13px;color:var(--gold)}

/* Smooth scroll bars */
::-webkit-scrollbar-thumb{background:linear-gradient(180deg,rgba(212,175,55,.3),rgba(212,175,55,.15));border-radius:3px}

/* Modal premium */
.modal{box-shadow:var(--shadow-deep),0 0 60px rgba(212,175,55,.08);border-color:rgba(212,175,55,.18)}
.modal-backdrop{background:rgba(0,0,0,.78);backdrop-filter:blur(14px) saturate(140%);-webkit-backdrop-filter:blur(14px) saturate(140%)}

/* Filter chips — premium */
.chip{transition:all .25s var(--ease-spring);font-weight:600}
.chip.active{box-shadow:0 4px 14px rgba(212,175,55,.4),0 1px 0 rgba(255,255,255,.25) inset}
.chip:hover:not(.active){background:rgba(255,255,255,.06);color:#fff}

/* Tabs — premium */
.tab{transition:all .25s var(--ease-spring)}
.tab.active{box-shadow:0 4px 14px rgba(212,175,55,.35),0 1px 0 rgba(255,255,255,.25) inset}

/* Inputs focus glow */
.input-wrap:focus-within,.search-bar:focus-within{
  border-color:var(--gold);
  box-shadow:0 0 0 4px rgba(212,175,55,.12),0 4px 18px rgba(212,175,55,.1);
}

/* Chat fab premium */
.chat-fab{
  background:linear-gradient(135deg,var(--gold-2),var(--gold) 50%,#b8932c);
  box-shadow:0 8px 28px rgba(212,175,55,.45),0 2px 0 rgba(255,255,255,.3) inset;
  animation:fabFloat 3.4s ease-in-out infinite;
}
@keyframes fabFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-4px)}}
.chat-fab:hover{transform:scale(1.08)}

/* Status pills upgrade */
.status-pill{backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);letter-spacing:.3px}

/* Product detail — bigger, more premium */
.pd-title{
  background:linear-gradient(180deg,#fff,#cfcfd2);
