      '<div class="divider"></div>'+
      '<div class="section-header"><h3 class="section-title">My Tickets</h3></div>'+
      '<button class="btn btn-primary mb-12" onclick="App.createTicket()">+ New Ticket</button>'+
      (tickets.length?tickets.map(t=>
        '<div class="ticket-item" onclick="App.viewTicket(\''+t.id+'\')">'+
        '<div class="ticket-head"><span style="font-weight:600">'+esc(t.subject)+'</span>'+
        '<span class="status-pill status-'+(t.status==="open"?"pending":"completed")+'">'+t.status+'</span></div>'+
