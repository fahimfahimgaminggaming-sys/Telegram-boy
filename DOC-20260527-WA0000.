  /* ---------- MODAL ---------- */
  openModal(title, body, onSave, hideCancel){
    this.closeModal();
    const m = document.createElement("div");
    m.className="modal-backdrop";
    m.innerHTML = '<div class="modal">'+
      '<div class="modal-head"><div class="modal-title">'+esc(title)+'</div><button class="close-btn" onclick="App.closeModal()">✕</button></div>'+
      '<div class="modal-body">'+body+'</div>'+
      (onSave||!hideCancel?'<div class="modal-foot">'+
        (!hideCancel?'<button class="btn btn-secondary" onclick="App.closeModal()">Cancel</button>':'')+
        (onSave?'<button class="btn btn-primary" id="modalSave">Save</button>':'')+
        (!onSave&&hideCancel?'<button class="btn btn-primary" onclick="App.closeModal()">Close</button>':'')+
      '</div>':'<div class="modal-foot"><button class="btn btn-primary" onclick="App.closeModal();App.go(\'orders\')">View Orders</button></div>');
