<script>
(function(){
  'use strict';
  var reducedMotion = window.matchMedia('(prefers-reduced-motion:reduce)').matches;
  var isMobile = /Android|iPhone|iPad|iPod|Mobile/i.test(navigator.userAgent);
  var PARTICLE_COUNT = isMobile ? 24 : 48;

  function spawnParticles(container) {
    container.innerHTML = '';
    if (reducedMotion) return;
    var frag = document.createDocumentFragment();
    for (var i = 0; i < PARTICLE_COUNT; i++) {
      var p = document.createElement('span');
      p.className = 'particle';
      var size = Math.random() * 7 + 2;
      var startY = 80 + Math.random() * 40;
      p.style.cssText =
        'width:' + size + 'px;' +
        'height:' + size + 'px;' +
        'left:' + (Math.random() * 100) + '%;' +
        'top:' + startY + '%;' +
        'bottom:auto;' +
        'animation-duration:' + (Math.random() * 10 + 7) + 's;' +
        'animation-delay:-' + (Math.random() * 12) + 's;';
      frag.appendChild(p);
    }
    container.appendChild(frag);
  }

  function bootVideo(hero) {
    var vid = hero.querySelector('.hero-video');
    if (!vid) return;
    try {
      var pp = vid.play();
      if (pp && typeof pp.catch === 'function') pp.catch(function(){});
    } catch(e) {}
    vid.addEventListener('error', function() {
      vid.style.display = 'none';
    }, { once: true });
  }

  function initCinematicHero() {
    var hero = document.getElementById('hero');
    if (!hero) return;
    var particles = document.getElementById('goldParticles');
    if (particles) spawnParticles(particles);
    bootVideo(hero);
  }

  if (window.App && typeof window.App.afterRender === 'function') {
    var _origAfterRender = window.App.afterRender.bind(window.App);
    window.App.afterRender = function() {
      _origAfterRender();
      if (this.route === 'home' || !this.route) {
        requestAnimationFrame(function() {
          requestAnimationFrame(initCinematicHero);
        });
      }
    };
  }

  document.addEventListener('DOMContentLoaded', function() {
    requestAnimationFrame(function() {
      requestAnimationFrame(initCinematicHero);
    });
  });
})();

</script>

