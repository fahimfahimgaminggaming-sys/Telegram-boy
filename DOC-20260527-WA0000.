/* Auth card entrance animation */
.auth-card{animation:authCardIn .55s var(--ease-out);}
@keyframes authCardIn{
  from{opacity:0;transform:translateY(24px) scale(.96);filter:blur(4px);}
  to{opacity:1;transform:none;filter:blur(0);}
}

/* Staggered field entrance */
.auth-card .field:nth-child(1){animation:fadeUp .4s var(--ease-out) .1s both;}
.auth-card .field:nth-child(2){animation:fadeUp .4s var(--ease-out) .18s both;}
.auth-card .field:nth-child(3){animation:fadeUp .4s var(--ease-out) .26s both;}
.auth-card .btn-primary{animation:fadeUp .4s var(--ease-out) .32s both;}
.auth-divider{animation:fadeUp .4s var(--ease-out) .4s both;}
.social-btn-group{animation:fadeUp .4s var(--ease-out) .46s both;}
.social-trust{animation:fadeIn .4s var(--ease-out) .54s both;}
.auth-bottom-row{animation:fadeUp .4s var(--ease-out) .28s both;}

/* Auth tab premium */
.auth-tab{
  position:relative;overflow:hidden;border-radius:10px;
  transition:color .25s,transform .2s var(--ease-spring);
}
.auth-tab.active::before{
  content:"";position:absolute;inset:0;border-radius:inherit;
  background:linear-gradient(135deg,rgba(212,175,55,.1),rgba(212,175,55,.05));
  pointer-events:none;
}
.auth-tab:hover:not(.active){color:var(--text);}

